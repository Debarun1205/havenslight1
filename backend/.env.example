# MongoDB Atlas connection string (or local MongoDB URI for development)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/travel-safety?retryWrites=true&w=majority

# JWT signing secret — use a long, random string in production
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=30d

# Port the Express server listens on
PORT=5000

# Frontend URL, for CORS — set this to your deployed frontend's URL in production
CLIENT_URL=http://localhost:5173

NODE_ENV=development

# --- SOS email notifications (optional but recommended) ---
# Provider-agnostic SMTP — works with any provider, shown here with Gmail
# since it's free and fastest to set up for a solo project:
#   1. Turn on 2-Step Verification on the Gmail account you'll send from:
#      https://myaccount.google.com/security
#   2. Create an "App Password": https://myaccount.google.com/apppasswords
#      (choose "Mail" as the app) — use the generated 16-character code
#      below as SMTP_PASS, NOT your real Gmail password.
# Contacts without an email on file are simply skipped — this does not
# replace SMS, which requires DLT registration for Indian numbers before
# any provider (Twilio, MSG91, etc.) can legally send to them.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-character-app-password
ALERT_FROM_NAME=HavensLight
ALERT_FROM_EMAIL=your-address@gmail.com

# Radii (meters) for volunteer/guardian matching — optional, these are the defaults
VOLUNTEER_NEARBY_RADIUS_METERS=3000
SOS_ALERT_RADIUS_METERS=5000
